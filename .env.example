# Site mode: "review" (default) or "live". Server-side only.
SITE_MODE=

# Canonical base URL, no trailing slash.
SITE_URL=

# Cloudinary cloud name (public, not a secret).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Resend API key (sensitive, server-side only).
RESEND_API_KEY=

# Sender address, for example: KGICL Website <website@notify.kgiclsolar.com>
CONTACT_FROM_EMAIL=

# Recipient address. Review: the developer's address. Live: info@kgiclsolar.com
CONTACT_TO_EMAIL=

# Social links. Leave blank to hide an icon.
FACEBOOK_URL=
INSTAGRAM_URL=
LINKEDIN_URL=

# "true" or "false". Defaults to false in review and true in live.
HIDE_UNVERIFIED_SPECS=
